{
  "ci": {
    "collect": {
      "url": [
        "https://kabix09.github.io/codeforpoznan.pl/"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "npm run build && node .output/server/index.mjs"
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.60 }],
        "categories:accessibility": ["error", { "minScore": 0.75 }],
        "categories:seo": ["error", { "minScore": 0.85 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}